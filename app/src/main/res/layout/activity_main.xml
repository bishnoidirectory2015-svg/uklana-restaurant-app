<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FFF7ED">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="#FF7A00">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
    <TextView android:id="@+id/restaurantName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Restaurant" android:textColor="#FFFFFF" android:textSize="19sp" android:textStyle="bold"/>
    <TextView android:id="@+id/restaurantPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="13sp"/>
   </LinearLayout>
   <Button android:id="@+id/ringtoneButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔔 RING"/>
   <Button android:id="@+id/logoutButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOGOUT"/>
  </LinearLayout>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="#FFFFFF" android:padding="14dp">
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Restaurant Status" android:textStyle="bold" android:textSize="17sp"/>
   <TextView android:id="@+id/openStatusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CLOSED" android:textStyle="bold" android:textSize="14sp"/>
  </LinearLayout>
  <Switch android:id="@+id/openSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="#222222">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
   <Button android:id="@+id/paymentPendingTab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PENDING PAYMENT"/>
   <Button android:id="@+id/paymentReceivedTab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="RECEIVED HISTORY"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="8dp">
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PENDING PAYMENT" android:textColor="#FFFFFF" android:textStyle="bold"/>
    <TextView android:id="@+id/runningTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹0" android:textColor="#FFFFFF" android:textSize="34sp" android:textStyle="bold"/>
   </LinearLayout>
   <Button android:id="@+id/resetTotalButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RECEIVED"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/receivedHistoryContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:paddingTop="8dp"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="8dp">
  <Button android:id="@+id/pendingTab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PENDING
0"/>
  <Button android:id="@+id/doneTab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="DONE
0"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="12dp" android:paddingRight="12dp">
  <TextView android:id="@+id/statusText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Orders" android:textStyle="bold"/>
  <TextView android:id="@+id/pendingCount" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
  <TextView android:id="@+id/doneCount" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
  <Button android:id="@+id/refreshButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="REFRESH"/>
 </LinearLayout>
 <ProgressBar android:id="@+id/progressBar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone"/>
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <LinearLayout android:id="@+id/ordersContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="20dp"/>
 </ScrollView>
</LinearLayout>